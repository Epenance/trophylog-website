---
interface Props {
  images: { src: string; alt: string }[];
  size?: 'default' | 'sm';
  glowColor?: 'green' | 'gold';
  class?: string;
  ariaLabel?: string;
}

const {
  images,
  size = 'default',
  glowColor = 'green',
  class: className = '',
  ariaLabel = 'App screenshots',
} = Astro.props;

const isSlider = images.length > 1;
const frameClass = size === 'sm' ? 'phone-frame phone-frame-sm' : 'phone-frame';
const glowClass = `phone-glow phone-glow-${glowColor}`;
---

<div class:list={['phone-slider-wrap', className]} style="flex-shrink:0;position:relative;">
  <div class={glowClass}></div>
  <div class={frameClass}>
    <div class="phone-notch"></div>
    <div class="phone-screen">
      {isSlider ? (
        <div
          class="phone-screen-inner slider-track"
          role="region"
          aria-roledescription="carousel"
          aria-label={ariaLabel}
          style={`width:${images.length * 100}%;touch-action:pan-y;`}
          data-slide-count={images.length}
        >
          {images.map((img, i) => (
            <div
              class="slider-slide"
              role="tabpanel"
              aria-label={`Slide ${i + 1} of ${images.length}`}
              style={`width:${100 / images.length}%;`}
            >
              <img src={img.src} alt={img.alt} class="phone-screenshot" />
            </div>
          ))}
        </div>
      ) : (
        <div class="phone-screen-inner">
          <img src={images[0].src} alt={images[0].alt} class="phone-screenshot" />
        </div>
      )}
    </div>
  </div>
  {isSlider && (
    <div class="slider-dots" role="tablist" aria-label="Slide navigation">
      {images.map((_, i) => (
        <button
          class:list={['slider-dot', { active: i === 0 }]}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={`Slide ${i + 1} of ${images.length}`}
          data-slide-index={i}
        />
      ))}
    </div>
  )}
</div>

<style>
  /* Glow */
  .phone-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 400px;
    height: 500px;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .phone-glow-green {
    background: radial-gradient(ellipse, rgba(74, 222, 128, 0.12) 0%, transparent 70%);
  }

  .phone-glow-gold {
    background: radial-gradient(ellipse, rgba(201, 160, 78, 0.12) 0%, transparent 70%);
  }

  /* Frame */
  .phone-frame {
    width: 280px;
    height: 580px;
    border-radius: 44px;
    border: 1.5px solid rgba(74, 222, 128, 0.12);
    background: #0F1612;
    overflow: hidden;
    position: relative;
    z-index: 1;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.3),
      0 0 60px -10px rgba(74, 222, 128, 0.08),
      0 50px 100px -20px rgba(0, 0, 0, 0.8),
      0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  .phone-frame-sm {
    width: 260px;
    height: 540px;
    border-radius: 40px;
  }

  /* Notch */
  .phone-notch {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 28px;
    background: #080C0A;
    border-radius: 16px;
    z-index: 2;
  }

  .phone-frame-sm .phone-notch {
    width: 88px;
    height: 24px;
    top: 10px;
    border-radius: 14px;
  }

  /* Screen */
  .phone-screen {
    width: 100%;
    height: 100%;
    padding: 6px;
    overflow: hidden;
  }

  .phone-screen-inner {
    width: 100%;
    height: 100%;
    background: #0F1612;
    border-radius: 38px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .phone-frame-sm .phone-screen-inner {
    border-radius: 34px;
  }

  /* Screenshots */
  .phone-screenshot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: inherit;
  }

  /* Slider track */
  .slider-track {
    display: flex;
    flex-direction: row;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .slider-slide {
    height: 100%;
    flex-shrink: 0;
    overflow: hidden;
  }

  .slider-slide .phone-screenshot {
    border-radius: 0;
  }

  /* First and last slides keep their outer radii */
  .slider-slide:first-child .phone-screenshot {
    border-top-left-radius: 38px;
    border-bottom-left-radius: 38px;
  }

  .slider-slide:last-child .phone-screenshot {
    border-top-right-radius: 38px;
    border-bottom-right-radius: 38px;
  }

  .phone-frame-sm .slider-slide:first-child .phone-screenshot {
    border-top-left-radius: 34px;
    border-bottom-left-radius: 34px;
  }

  .phone-frame-sm .slider-slide:last-child .phone-screenshot {
    border-top-right-radius: 34px;
    border-bottom-right-radius: 34px;
  }

  /* Dots */
  .slider-dots {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 16px;
    position: relative;
    z-index: 1;
  }

  .slider-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(201, 160, 78, 0.3);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .slider-dot:hover {
    background: rgba(201, 160, 78, 0.5);
  }

  .slider-dot.active {
    background: #C9A04E;
    transform: scale(1.3);
  }

  .slider-dot:focus-visible {
    outline: 2px solid #C9A04E;
    outline-offset: 2px;
  }

  /* ——— Responsive: Mobile ——— */
  @media (max-width: 640px) {
    .phone-frame {
      width: 220px;
      height: 460px;
      border-radius: 36px;
    }

    .phone-frame .phone-notch {
      width: 76px;
      height: 22px;
      top: 10px;
      border-radius: 12px;
    }

    .phone-frame .phone-screen-inner {
      border-radius: 30px;
    }

    .phone-frame-sm {
      width: 200px;
      height: 420px;
      border-radius: 32px;
    }

    .phone-frame-sm .phone-notch {
      width: 68px;
      height: 20px;
      top: 8px;
      border-radius: 11px;
    }

    .phone-frame-sm .phone-screen-inner {
      border-radius: 26px;
    }

    .phone-glow {
      width: 260px;
      height: 340px;
    }

    /* Slider slide radii must match responsive screen-inner radii */
    .slider-slide:first-child .phone-screenshot {
      border-top-left-radius: 30px;
      border-bottom-left-radius: 30px;
    }

    .slider-slide:last-child .phone-screenshot {
      border-top-right-radius: 30px;
      border-bottom-right-radius: 30px;
    }

    .phone-frame-sm .slider-slide:first-child .phone-screenshot {
      border-top-left-radius: 26px;
      border-bottom-left-radius: 26px;
    }

    .phone-frame-sm .slider-slide:last-child .phone-screenshot {
      border-top-right-radius: 26px;
      border-bottom-right-radius: 26px;
    }

    .slider-dots {
      margin-top: 12px;
    }

    .slider-dot {
      width: 5px;
      height: 5px;
    }
  }

  /* ——— Responsive: Small Mobile ——— */
  @media (max-width: 380px) {
    .phone-frame {
      width: 200px;
      height: 420px;
      border-radius: 32px;
    }

    .phone-frame-sm {
      width: 180px;
      height: 380px;
      border-radius: 28px;
    }
  }
</style>
