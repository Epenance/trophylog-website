			<table>
				<thead>
					<tr>
						<th>Data</th>
						<th>Examples</th>
						<th>Purpose</th>
						<th>Legal basis (GDPR Art. 6)</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Account data</td>
						<td>Email address, name, user ID, authentication identifiers (incl. Sign in with Google/Apple)</td>
