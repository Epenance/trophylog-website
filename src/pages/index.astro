		}

		.nav-brand {
			font-size: 18px;
		}

		/* Hero */
		.hero {
			min-height: calc(100vh - 60px);
			min-height: calc(100dvh - 60px);
			gap: 40px;
			padding-top: 90px;
			padding-bottom: 60px;
		}

		.hero-title {
			font-size: clamp(40px, 12vw, 56px);
			margin-bottom: 20px;
		}

		.hero-sub {
			font-size: 17px;
			margin-bottom: 0;
		}

		.hero-glow {
			width: 100%;
			height: 300px;
		}

		/* Phones — scale down properly */
		.phone-frame {
			width: 220px;
			height: 460px;
			border-radius: 36px;
		}

		.phone-frame .phone-notch {
			width: 76px;
			height: 22px;
			top: 10px;
			border-radius: 12px;
		}

		.phone-frame .phone-screen-inner {
			border-radius: 30px;
		}

		.phone-frame-sm {
			width: 200px;
			height: 420px;
			border-radius: 32px;
		}

		.phone-frame-sm .phone-notch {
			width: 68px;
			height: 20px;
			top: 8px;
			border-radius: 11px;
		}

		.phone-frame-sm .phone-screen-inner {
			border-radius: 26px;
		}

		/* Contain glows to prevent horizontal scroll */
		.phone-glow {
			width: 260px;
			height: 340px;
		}

		.medal-glow {
			width: 320px;
			height: 320px;
		}

		/* Section typography */
		.section-title {
			font-size: clamp(28px, 7vw, 38px);
		}

		.section-body {
			font-size: 16px;
			line-height: 1.7;
		}

		.section-label {
			font-size: 11px;
			margin-bottom: 14px;
		}

		.story-text {
			font-size: clamp(18px, 5vw, 24px);
		}

		/* Medal — smaller on mobile */
		.medal-object {
			width: 220px;
			height: 220px;
		}

		.medal-face {
			width: 150px;
			height: 150px;
		}

		.medal-ring-outer {
			width: 200px;
			height: 200px;
		}

		.medal-ring-inner {
			width: 180px;
			height: 180px;
		}

		.medal-engrave {
			width: 48px;
			height: 48px;
		}

		.medal-qr-icon {
			width: 36px;
			height: 36px;
		}

		/* Feature blocks — phone above text */
		.feature-block,
		.feature-block-reverse {
			gap: 36px;
			margin-bottom: clamp(72px, 12vh, 120px);
		}

		/* CTA */
		.cta-title {
			font-size: clamp(32px, 9vw, 48px);
		}

		.cta-body {
