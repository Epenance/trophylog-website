	}

	.footer-badges-row {
		display: flex;
		gap: 12px;
		justify-content: center;
		flex-wrap: wrap;
	}

	.store-badge {
		transition: transform 0.2s ease, opacity 0.2s ease;
		opacity: 0.5;
	}

	.store-badge:hover {
		transform: translateY(-1px);
		opacity: 0.7;
	}

	.store-badge svg {
		height: 36px;
		width: auto;
	}

	/* ——————————————————————————————————————
	   RESPONSIVE — TABLET
	   —————————————————————————————————————— */

	@media (max-width: 900px) {
		.feature-block,
		.feature-block-reverse {
			flex-direction: column;
			text-align: center;
			gap: 48px;
		}

		.feature-content .section-body {
			max-width: none;
			margin: 0 auto;
		}

		.medal-layout {
			flex-direction: column;
			text-align: center;
			gap: 56px;
		}

		.medal-content .section-body {
			max-width: none;
			margin: 0 auto;
		}
	}

	/* ——————————————————————————————————————
	   RESPONSIVE — MOBILE
	   —————————————————————————————————————— */

	@media (max-width: 640px) {

		/* Reduce section spacing */
		:root {
			--section-gap: clamp(72px, 12vh, 120px);
		}

		/* Nav */
		.nav {
