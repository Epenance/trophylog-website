	.footer-brand {
		font-family: var(--font-display);
		font-size: 16px;
		font-weight: 700;
		color: var(--gold);
		opacity: 0.7;
	}

	.footer-copy {
		font-size: 14px;
		color: var(--text-tertiary);
	}

	.footer-badges {
		margin-top: 32px;
		padding-top: 32px;
		border-top: 1px solid rgba(201, 160, 78, 0.06);
		text-align: center;
	}

	.footer-badges-label {
		display: block;
		font-size: 13px;
		color: var(--text-tertiary);
		margin-bottom: 16px;
