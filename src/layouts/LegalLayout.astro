---
import Layout from './Layout.astro';

interface Props {
	title: string;
	heading: string;
	headingDa: string;
	meta: string;
	metaDa: string;
}

const { title, heading, headingDa, meta, metaDa } = Astro.props;
---

<Layout title={title}>

	<!-- Navigation -->
	<nav class="q-nav scrolled">
		<div class="q-nav-inner">
			<a href="/" class="q-brand">
				<svg viewBox="0 0 946.59 766.6" aria-hidden="true">
					<path fill="currentColor" d="M453.32,764.64c6.73,4.91,11.91.57,14.73-12.48,13.21-61.18,29.36-123.62,66.26-175.72,75.87-112.41,201.49-168.53,281.23-278.61,46.15-62.56,91.35-138.15,113.93-212,8.7-28.45,24.38-82.19,13.3-85.59-1.69-.52-4.24-.55-7.77,4.03-8.8,11.39-18.34,33.8-26.69,48.64-57.07,101.43-178.18,300.16-265.64,317.04-41.8,8.07-37.77-63.87-32.96-102.83,3.59-29.11,14.01-52.69,23.38-79.29,7.03-19.95,11.46-42.47,4.29-42.93-16.65-1.08-65.91,79.85-80.67,115.78-28.44,69.22-29.22,133.8-68.62,195.33-20.03,31.29-35.61-1.54-32.56-59.81,1.93-36.91,12.14-68.44,18.52-102.35,1.25-6.64,1.58-12.94.4-14.99-3.86-6.71-17.76,17.02-20.65,22.74-35.16,69.62-68.06,177.21-63.92,267.93,2.89,63.23,12.98,150.22,61.67,193.7.36.32,1.26,1.05,1.77,1.42Z"/>
					<path fill="currentColor" d="M300.55,512.24c-8.43-38.35-19.07-77.21-41.97-110.06-48.63-69.79-126.77-105.24-177.05-174.1C52.44,188.94,25.98,140.97,11.64,94.7,6.12,76.87-2.63,45.38.76,42.37c1.28-1.14,3.67-.27,5.17,1.84,5.23,7.36,11.61,21.14,16.85,30.45,36.24,63.37,112.79,186.27,167.35,198.24,26.37,4.2,23.2-40.11,20.44-64.58-2.58-18.22-9-32.98-14.85-49.68-4.52-12.48-8.16-27.72-2.79-26.92,11.66,1.74,41.52,49.93,50.87,72.43,18,43.35,20.03,82.99,43.49,122.36,13.33,19.12,22.78-1.08,20.28-37.59-1.01-23.16-7.78-42.9-11.85-64.15-.8-4.16-1.03-7.12-.25-8.13,2.85-3.69,11.05,9.4,12.97,12.94,21.11,44.13,43.4,111.01,40.72,167.91-2.07,43.79-7.84,95.67-38.66,122.2-.16.14-.5.41-.67.54-4,3.36-7.48.18-9.28-8.01Z"/>
				</svg>
				TrophyLog
			</a>
			<a href="/" class="q-nav-cta">Home</a>
		</div>
	</nav>

	<main class="legal show-en" id="legal">
		<header class="legal-header">
			<div class="lang-toggle" role="group" aria-label="Language">
				<button type="button" class="lang-btn active" data-lang="en" aria-pressed="true">English</button>
				<button type="button" class="lang-btn" data-lang="da" aria-pressed="false">Dansk</button>
			</div>
			<h1 class="legal-title lang-en">{heading}</h1>
			<h1 class="legal-title lang-da" lang="da">{headingDa}</h1>
			<p class="legal-meta lang-en">{meta}</p>
			<p class="legal-meta lang-da" lang="da">{metaDa}</p>
		</header>

		<article class="legal-content lang-en">
			<slot name="en" />
		</article>
		<article class="legal-content lang-da" lang="da">
			<slot name="da" />
		</article>
	</main>

	<!-- Footer -->
	<footer class="q-foot">
		<div class="q-foot-inner">
			<div>&copy; {new Date().getFullYear()} · TrophyLog A/S · Denmark</div>
			<div class="q-foot-links">
				<a href="/privacy">Privacy</a>
				<a href="/terms">Terms</a>
				<a href="mailto:contact@trophylog.com">Contact</a>
			</div>
		</div>
	</footer>

</Layout>

<style>
	/* ——————————————————————————————————————
	   NAV (quarry, always-scrolled state)
	   —————————————————————————————————————— */

	.q-nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		padding: 14px var(--page-pad);
		background: rgba(5, 7, 6, 0.85);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border-bottom: 1px solid var(--line);
	}

	.q-nav-inner {
		max-width: var(--maxw);
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 24px;
	}

	.q-brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-display);
		font-size: 22px;
		font-weight: 700;
		color: var(--text);
	}

	.q-brand svg {
		width: 26px;
		height: auto;
		color: var(--accent);
	}

	.q-nav-cta {
		margin-left: auto;
		padding: 11px 22px;
		background: var(--text);
		color: var(--bg);
		border-radius: 2px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		transition: all 0.2s ease;
	}

	.q-nav-cta:hover {
		background: var(--accent);
		color: var(--accent-text);
	}

	/* ——————————————————————————————————————
	   PAGE STRUCTURE
	   —————————————————————————————————————— */

	.legal {
		max-width: var(--narrow);
		margin: 0 auto;
		padding: 160px var(--page-pad) 120px;
	}

	.legal-header {
		margin-bottom: 56px;
	}

	.legal-title {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(38px, 6vw, 60px);
		line-height: 1.02;
		letter-spacing: -0.03em;
		color: var(--text);
		margin-bottom: 16px;
		font-variation-settings: "opsz" 96;
	}

	.legal-meta {
		font-size: 14px;
		color: var(--text-2);
		letter-spacing: 0.04em;
	}

	/* ——————————————————————————————————————
	   LANGUAGE TOGGLE
	   —————————————————————————————————————— */

	.lang-toggle {
		display: inline-flex;
		gap: 4px;
		padding: 4px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 2px;
		margin-bottom: 32px;
	}

	.lang-btn {
		padding: 8px 20px;
		background: transparent;
		border: none;
		border-radius: 2px;
		color: var(--text-2);
		font-family: var(--font-body);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease;
	}

	.lang-btn:hover {
		color: var(--text);
	}

	.lang-btn.active {
		background: var(--surface-2);
		color: var(--accent);
	}

	.legal .lang-da {
		display: none;
	}

	.legal.show-da .lang-da {
		display: block;
	}

	.legal.show-da .lang-en {
		display: none;
	}

	/* ——————————————————————————————————————
	   PROSE
	   —————————————————————————————————————— */

	.legal-content {
		font-size: 16px;
		line-height: 1.75;
		color: var(--text-2);
	}

	.legal-content :global(h2) {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(24px, 3.5vw, 32px);
		letter-spacing: -0.02em;
		color: var(--text);
		margin: 48px 0 16px;
		font-variation-settings: "opsz" 48;
	}

	.legal-content :global(h2:first-child) {
		margin-top: 0;
	}

	.legal-content :global(p) {
		margin-bottom: 16px;
	}

	.legal-content :global(ul) {
		margin: 0 0 16px;
		padding-left: 24px;
	}

	.legal-content :global(li) {
		margin-bottom: 10px;
	}

	.legal-content :global(strong) {
		color: var(--text);
		font-weight: 600;
	}

	.legal-content :global(a) {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-color: rgba(74, 222, 128, 0.4);
		text-underline-offset: 3px;
		transition: text-decoration-color 0.2s ease;
	}

	.legal-content :global(a:hover) {
		text-decoration-color: var(--accent);
	}

	.legal-content :global(.table-wrap) {
		overflow-x: auto;
		margin-bottom: 16px;
		border: 1px solid var(--line);
		border-radius: 2px;
	}

	.legal-content :global(table) {
		width: 100%;
		min-width: 640px;
		border-collapse: collapse;
		font-size: 14px;
		line-height: 1.6;
	}

	.legal-content :global(th),
	.legal-content :global(td) {
		padding: 12px 16px;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--line);
	}

	.legal-content :global(th) {
		background: var(--surface);
		color: var(--text);
		font-weight: 600;
		white-space: nowrap;
	}

	.legal-content :global(tr:last-child td) {
		border-bottom: none;
	}

	/* ——————————————————————————————————————
	   FOOTER (quarry)
	   —————————————————————————————————————— */

	.q-foot {
		padding: 48px var(--page-pad);
		border-top: 1px solid var(--line);
		color: var(--text-3);
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.q-foot-inner {
		max-width: var(--maxw);
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 16px;
	}

	.q-foot-links {
		display: flex;
		gap: 20px;
	}

	.q-foot a {
		transition: color 0.2s ease;
	}

	.q-foot a:hover {
		color: var(--accent);
	}

	@media (max-width: 640px) {
		.legal {
			padding-top: 120px;
			padding-bottom: 80px;
		}
	}
</style>

<script>
	type Lang = 'en' | 'da';

	const STORAGE_KEY = 'trophylog-legal-lang';
	const legal = document.getElementById('legal');
	const buttons = document.querySelectorAll<HTMLButtonElement>('.lang-btn');

	function isLang(value: string | null): value is Lang {
		return value === 'en' || value === 'da';
	}

	function applyLang(lang: Lang) {
		if (!legal) return;
		legal.classList.toggle('show-da', lang === 'da');
		legal.classList.toggle('show-en', lang === 'en');
		document.documentElement.lang = lang;
		buttons.forEach((btn) => {
			const active = btn.dataset.lang === lang;
			btn.classList.toggle('active', active);
			btn.setAttribute('aria-pressed', String(active));
		});
	}

	function rememberLang(lang: Lang) {
		try {
			localStorage.setItem(STORAGE_KEY, lang);
		} catch {}
		try {
			const url = new URL(window.location.href);
			url.searchParams.set('lang', lang);
			history.replaceState(history.state, '', url);
		} catch {}
	}

	/**
	 * Resolve the initial language deterministically:
	 *   1. `?lang=en|da` in the URL (stable deep links from the app / stores)
	 *   2. the last choice saved in localStorage
	 *   3. English
	 */
	function initialLang(): Lang {
		const fromUrl = new URLSearchParams(window.location.search).get('lang');
		if (isLang(fromUrl)) return fromUrl;
		try {
			const saved = localStorage.getItem(STORAGE_KEY);
			if (isLang(saved)) return saved;
		} catch {}
		return 'en';
	}

	buttons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const lang = btn.dataset.lang;
			if (!isLang(lang)) return;
			applyLang(lang);
			rememberLang(lang);
		});
	});

	applyLang(initialLang());
</script>
